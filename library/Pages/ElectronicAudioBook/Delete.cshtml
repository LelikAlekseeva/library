@page
@model library.Pages.ElectronicAudioBook.DeleteModel
@{
	ViewData["Title"] = "Удалить книгу";
}
<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card border-danger shadow-sm">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Удалить книгу</h4>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        Вы уверены, что хотите удалить эту книгу?
                    </div>

                    <div class="mb-3">

                        <h5 class="card-title">@Model.ElectronicAudioBook.Title</h5>

                        <p class="card-text text-muted">
                            Автор: @Model.ElectronicAudioBook.Author
                        </p>

                        <p class="card-text">
                            Год: <span class="badge bg-secondary">@Model.ElectronicAudioBook.Language</span>
                        </p>

                        <p class="card-text">
                            Экземпляров: <span class="badge bg-info">@Model.ElectronicAudioBook.Genre</span>
                        </p>

                    </div>

                    <form method="post">

                        <input type="hidden" asp-for="ElectronicAudioBook.Id" />

                        <div class="d-flex justify-content-between">

                            <a asp-page="Index" class="btn btn-secondary">
                                Отмена
                            </a>

                            <button type="submit" class="btn btn-danger">
                                Удалить
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>
