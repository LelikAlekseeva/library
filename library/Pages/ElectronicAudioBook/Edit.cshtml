@page "{id:int}"
@model library.Pages.ElectronicAudioBook.EditModel
@{
	ViewData["Title"] = "Редактировать книгу";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Редактировать книгу</h4>
                </div>

                <div class="card-body">

                    <form method="post">

                        <input type="hidden" asp-for="ElectronicAudioBook.Id" />

                        <div class="mb-3">
                            <label asp-for="ElectronicAudioBook.Title" class="form-label">Название</label>
                            <input asp-for="ElectronicAudioBook.Title" class="form-control" />
                            <span asp-validation-for="ElectronicAudioBook.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ElectronicAudioBook.Author" class="form-label">Автор</label>
                            <input asp-for="ElectronicAudioBook.Author.Name" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ElectronicAudioBook.Language" class="form-label">Год</label>
                            <input asp-for="ElectronicAudioBook.Language" type="number" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ElectronicAudioBook.Genre" class="form-label">Количество</label>
                            <input asp-for="ElectronicAudioBook.Genre" type="number" class="form-control" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-secondary">
                                Назад
                            </a>
                            <button type="submit" class="btn btn-warning">
                                Сохранить
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}   